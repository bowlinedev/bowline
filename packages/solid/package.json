{
  "name": "@bowlinedev/solid",
  "version": "1.1.0",
  "description": "Solid resource and action bindings for Bowline clients",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bowlinedev/bowline.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bowlinedev/client": "workspace:*",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@bowlinedev/client": "workspace:*",
    "@solidjs/testing-library": "0.8.10",
    "jsdom": "29.1.1",
    "solid-js": "1.9.15",
    "tsup": "8.5.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
