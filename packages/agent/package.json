{
  "name": "@bowline/agent",
  "version": "1.0.0",
  "description": "Tool definitions and a dispatcher for LLM agents over Bowline contracts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bowlinedev/bowline.git",
    "directory": "packages/agent"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bowline/client": "workspace:*"
  },
  "devDependencies": {
    "@bowline/client": "workspace:*",
    "@types/node": "24.7.0",
    "tsup": "8.5.0",
    "vitest": "3.2.4"
  }
}
