{
  "name": "@bowlinedev/react-query",
  "version": "1.4.1",
  "description": "TanStack Query bindings for Bowline clients",
  "keywords": [
    "bowline",
    "api-client",
    "react",
    "react-query",
    "tanstack",
    "typed",
    "hooks"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bowlinedev/bowline.git",
    "directory": "packages/react-query"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bowlinedev/client": "workspace:*",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@bowlinedev/client": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "tsup": "8.5.0",
    "vitest": "3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
