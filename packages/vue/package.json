{
  "name": "@bowlinedev/vue",
  "version": "1.4.1",
  "description": "Vue composables and TanStack Vue Query option builders for Bowline clients",
  "keywords": [
    "bowline",
    "api-client",
    "vue",
    "composables",
    "typed",
    "reactivity"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bowlinedev/bowline.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bowlinedev/client": "workspace:*",
    "@tanstack/vue-query": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/vue-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bowlinedev/client": "workspace:*",
    "@tanstack/vue-query": "5.103.0",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "vitest": "5.0.1",
    "vue": "3.5.42"
  },
  "publishConfig": {
    "access": "public"
  }
}
