{
  "name": "ledger-expo",
  "private": true,
  "main": "expo-router/entry",
  "version": "0.4.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "gen": "cp ../ledger/web/src/bowline.ts src/bowline.ts",
    "check:gen": "diff ../ledger/web/src/bowline.ts src/bowline.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@bowlinedev/client": "workspace:*",
    "@bowlinedev/react-query": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.19",
    "expo-constants": "58.0.13",
    "expo-router": "58.0.26",
    "expo-status-bar": "58.0.4",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "react-test-renderer": "19.3.1",
    "typescript": "7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@bowlinedev/client$": "<rootDir>/../../packages/client/src/index.ts",
      "^@bowlinedev/react-query$": "<rootDir>/../../packages/react-query/src/index.ts",
      "^\\./(.*)\\.js$": "./$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native(-community)?[+/]|expo(nent)?|@expo(nent)?[+/]|@expo-google-fonts[+/]|react-navigation|@react-navigation[+/]|@unimodules[+/]|unimodules|sentry-expo|native-base))"
    ]
  }
}
