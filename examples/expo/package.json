{
  "name": "ledger-expo",
  "private": true,
  "main": "expo-router/entry",
  "version": "0.4.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "gen": "cp ../ledger/web/src/bowline.ts src/bowline.ts",
    "check:gen": "diff ../ledger/web/src/bowline.ts src/bowline.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@bowline/client": "workspace:*",
    "@bowline/react-query": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "expo": "54.0.37",
    "expo-constants": "18.0.14",
    "expo-router": "6.0.24",
    "expo-status-bar": "3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@bowline/client$": "<rootDir>/../../packages/client/src/index.ts",
      "^@bowline/react-query$": "<rootDir>/../../packages/react-query/src/index.ts",
      "^\\./(.*)\\.js$": "./$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native(-community)?[+/]|expo(nent)?|@expo(nent)?[+/]|@expo-google-fonts[+/]|react-navigation|@react-navigation[+/]|@unimodules[+/]|unimodules|sentry-expo|native-base))"
    ]
  }
}
