{
  "name": "example-remix",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cp ../ledger/web/src/bowline.ts src/bowline.ts",
    "check:gen": "cmp ../ledger/web/src/bowline.ts src/bowline.ts",
    "dev": "react-router dev --port 3200",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bowline/client": "workspace:*",
    "@bowline/react-query": "workspace:*",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@tanstack/react-query": "5.90.2",
    "isbot": "5.2.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@react-router/dev": "7.18.4",
    "@types/node": "24.7.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
