{
  "name": "ledger-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cp ../ledger/web/src/bowline.ts src/bowline.ts",
    "check:gen": "cmp ../ledger/web/src/bowline.ts src/bowline.ts",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "start": "node ./dist/server/entry.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/solid-js": "7.1.0",
    "@bowlinedev/client": "workspace:*",
    "@bowlinedev/solid": "workspace:*",
    "astro": "7.4.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
