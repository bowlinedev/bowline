---
import { createServerClient } from "@bowlinedev/client/server";
import { createClient } from "../bowline.js";
import Invoices from "../components/Invoices.tsx";

const ledger = createServerClient(createClient, {
  url: "http://localhost:8080/api",
  request: Astro.request,
});
const page = await ledger.invoices.list({ limit: 20 });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Ledger on Astro</title>
  </head>
  <body>
    <h1>Ledger</h1>
    <h2>Rendered on the server</h2>
    <table>
      <thead>
        <tr><th>id</th><th>status</th><th>total</th></tr>
      </thead>
      <tbody>
        {page.items.map((invoice) => (
          <tr data-testid={`invoice-${invoice.id}`}>
            <td>{invoice.id}</td>
            <td>{invoice.status}</td>
            <td>{invoice.total}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h2>Solid island</h2>
    <Invoices client:only="solid-js" />
  </body>
</html>
