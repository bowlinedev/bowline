{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@bowline/client": ["../../packages/client/src/index.ts"],
      "@bowline/client/server": ["../../packages/client/src/server.ts"],
      "@bowline/solid": ["../../packages/solid/src/index.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src", "e2e", "playwright.config.ts"],
  "exclude": ["dist"]
}
