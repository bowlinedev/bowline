{
  "entry": "./api.Routes",
  "contract": "api/bowline.contract.json",
  "schemas": true,
  "dev": { "app": "/api" },
  "targets": {
    "ts": { "out": "web/src/bowline.ts", "zod": true },
    "go": { "out": "ledgerclient/client.go", "package": "ledgerclient" },
    "dart": { "out": "dart/lib/bowline.dart" },
    "python": { "out": "python/bowline.py" },
    "rust": { "out": "rust/src/bowline.rs" }
  },
  "openapi": {
    "out": "api/openapi.json",
    "title": "Ledger",
    "version": "0.5.0",
    "serverUrl": "http://localhost:8080/api"
  }
}
