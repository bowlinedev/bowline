{
  "openapi": "3.1.0",
  "info": {
    "title": "Ledger",
    "version": "1.3.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "tags": [
    {
      "name": "customers"
    },
    {
      "name": "invoices"
    }
  ],
  "paths": {
    "/customers.get": {
      "get": {
        "operationId": "customers.get",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCustomerInput"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "customers"
        ]
      }
    },
    "/customers.search": {
      "post": {
        "description": "Search finds customers whose name or email contains the query.",
        "operationId": "customers.search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchCustomersInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Customer"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "customers"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {},
                  "type": "object"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutput"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "description": "List returns a page of invoices, optionally filtered by status.",
        "operationId": "invoices.list",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListInvoicesInput"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Invoice"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      },
      "post": {
        "operationId": "invoices.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoiceInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      }
    },
    "/invoices.attach": {
      "post": {
        "description": "Attach stores a file against an invoice.",
        "operationId": "invoices.attach",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "input": {
                  "contentType": "application/json"
                }
              },
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "input": {
                    "$ref": "#/components/schemas/AttachInput"
                  }
                },
                "required": [
                  "input",
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attachment"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      }
    },
    "/invoices.attachments": {
      "get": {
        "operationId": "invoices.attachments",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAttachmentsInput"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Attachment"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      }
    },
    "/invoices.watch": {
      "get": {
        "description": "Watch streams every invoice change.",
        "operationId": "invoices.watch",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchInput"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            },
            "description": "A stream of server-sent events. Each message event carries one value; an error event carries the error envelope; a done event ends the stream."
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      }
    },
    "/invoices/{id}": {
      "delete": {
        "description": "Void cancels a draft or sent invoice.",
        "operationId": "invoices.void",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidInvoiceInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "412": {
            "$ref": "#/components/responses/InvoiceLocked"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      },
      "get": {
        "description": "Get returns one invoice by ID.",
        "operationId": "invoices.get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "invoices"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttachInput": {
        "additionalProperties": false,
        "properties": {
          "invoiceId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "invoiceId"
        ],
        "type": "object"
      },
      "Attachment": {
        "additionalProperties": false,
        "properties": {
          "contentType": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "invoiceId": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "format": "int64",
            "type": "integer"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "invoiceId",
          "name",
          "contentType",
          "size",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "CreateInvoiceInput": {
        "additionalProperties": false,
        "properties": {
          "customerId": {
            "format": "int64",
            "type": "integer"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array"
          },
          "note": {
            "maxLength": 500,
            "type": "string"
          }
        },
        "required": [
          "customerId",
          "lines"
        ],
        "type": "object"
      },
      "Customer": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CANCELED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS",
                  "UNAUTHENTICATED"
                ],
                "type": "string"
              },
              "details": {},
              "issues": {
                "items": {
                  "$ref": "#/components/schemas/Issue"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "GetCustomerInput": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "GetInvoiceInput": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "HealthOutput": {
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "version"
        ],
        "type": "object"
      },
      "Invoice": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "customerId": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array"
          },
          "note": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "total": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "total",
          "lines",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "InvoiceLocked": {
        "additionalProperties": false,
        "description": "InvoiceLocked is returned when an invoice can no longer change.",
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "InvoiceLockedEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "properties": {
              "error": {
                "properties": {
                  "details": {
                    "$ref": "#/components/schemas/InvoiceLocked"
                  },
                  "type": {
                    "const": "InvoiceLocked"
                  }
                },
                "required": [
                  "type",
                  "details"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        ]
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ],
        "type": "object"
      },
      "Line": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 200,
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "unitPrice": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "quantity",
          "unitPrice"
        ],
        "type": "object"
      },
      "ListAttachmentsInput": {
        "additionalProperties": false,
        "properties": {
          "invoiceId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "invoiceId"
        ],
        "type": "object"
      },
      "ListInvoicesInput": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "limit"
        ],
        "type": "object"
      },
      "Page_Attachment": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Attachment"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_Customer": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Customer"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Page_Invoice": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Invoice"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "SearchCustomersInput": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "Status": {
        "enum": [
          "draft",
          "sent",
          "paid",
          "void"
        ],
        "type": "string"
      },
      "VoidInvoiceInput": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "WatchInput": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "type": "object"
      }
    },
    "responses": {
      "ABORTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ABORTED."
      },
      "ALREADY_EXISTS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ALREADY_EXISTS."
      },
      "CANCELED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code CANCELED."
      },
      "DATA_LOSS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code DATA_LOSS."
      },
      "DEADLINE_EXCEEDED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code DEADLINE_EXCEEDED."
      },
      "FAILED_PRECONDITION": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code FAILED_PRECONDITION."
      },
      "INTERNAL": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INTERNAL."
      },
      "INVALID_ARGUMENT": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INVALID_ARGUMENT."
      },
      "InvoiceLocked": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/InvoiceLockedEnvelope"
            }
          }
        },
        "description": "InvoiceLocked is returned when an invoice can no longer change."
      },
      "NOT_FOUND": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code NOT_FOUND."
      },
      "OUT_OF_RANGE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code OUT_OF_RANGE."
      },
      "PERMISSION_DENIED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code PERMISSION_DENIED."
      },
      "RESOURCE_EXHAUSTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code RESOURCE_EXHAUSTED."
      },
      "UNAUTHENTICATED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAUTHENTICATED."
      },
      "UNAVAILABLE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAVAILABLE."
      },
