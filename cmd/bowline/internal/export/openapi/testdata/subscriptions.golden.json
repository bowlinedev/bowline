{
  "openapi": "3.1.0",
  "info": {
    "title": "subscriptions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "paths": {
    "/secret": {
      "post": {
        "operationId": "secret",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WatchInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Change"
                }
              }
            },
            "description": "A stream of server-sent events. Each message event carries one value; an error event carries the error envelope; a done event ends the stream."
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    },
    "/watch": {
      "get": {
        "description": "Watch streams every change.",
        "operationId": "watch",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchInput"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Change"
                }
              }
            },
            "description": "A stream of server-sent events. Each message event carries one value; an error event carries the error envelope; a done event ends the stream."
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "404": {
            "$ref": "#/components/responses/Gone"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Change": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "at",
          "tags"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CANCELED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS",
                  "UNAUTHENTICATED"
                ],
                "type": "string"
              },
              "details": {},
              "issues": {
                "items": {
                  "$ref": "#/components/schemas/Issue"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Gone": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "GoneEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "properties": {
              "error": {
                "properties": {
                  "details": {
                    "$ref": "#/components/schemas/Gone"
                  },
                  "type": {
                    "const": "Gone"
                  }
                },
                "required": [
                  "type",
                  "details"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        ]
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ],
        "type": "object"
      },
      "WatchInput": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "limit"
        ],
        "type": "object"
      }
    },
    "responses": {
      "ABORTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ABORTED."
      },
      "ALREADY_EXISTS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ALREADY_EXISTS."
      },
      "CANCELED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code CANCELED."
      },
      "DATA_LOSS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code DATA_LOSS."
      },
      "DEADLINE_EXCEEDED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code DEADLINE_EXCEEDED."
      },
      "FAILED_PRECONDITION": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code FAILED_PRECONDITION."
      },
      "Gone": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GoneEnvelope"
            }
          }
        },
        "description": "Error variant Gone with code NOT_FOUND."
      },
      "INTERNAL": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INTERNAL."
      },
      "INVALID_ARGUMENT": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INVALID_ARGUMENT."
      },
      "NOT_FOUND": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code NOT_FOUND."
      },
      "OUT_OF_RANGE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code OUT_OF_RANGE."
      },
      "PERMISSION_DENIED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code PERMISSION_DENIED."
      },
      "RESOURCE_EXHAUSTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code RESOURCE_EXHAUSTED."
      },
      "UNAUTHENTICATED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAUTHENTICATED."
      },
      "UNAVAILABLE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAVAILABLE."
      },
      "UNIMPLEMENTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNIMPLEMENTED."
      },
      "UNKNOWN": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNKNOWN."
      }
    }
  }
}
