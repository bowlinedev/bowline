{
  "openapi": "3.1.0",
  "info": {
    "title": "uploads",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "paths": {
    "/attach": {
      "post": {
        "description": "Attach stores a file.",
        "operationId": "attach",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "input": {
                  "contentType": "application/json"
                }
              },
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "input": {
                    "$ref": "#/components/schemas/AttachInput"
                  }
                },
                "required": [
                  "input",
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attachment"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttachInput": {
        "additionalProperties": false,
        "properties": {
          "invoiceId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "invoiceId"
        ],
        "type": "object"
      },
      "Attachment": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "size"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CANCELED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS",
                  "UNAUTHENTICATED"
                ],
                "type": "string"
              },
              "details": {},
              "issues": {
                "items": {
                  "$ref": "#/components/schemas/Issue"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "ABORTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ABORTED."
      },
      "ALREADY_EXISTS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ALREADY_EXISTS."
      },
      "CANCELED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code CANCELED."
      },
      "DATA_LOSS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code DATA_LOSS."
      },
      "DEADLINE_EXCEEDED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code DEADLINE_EXCEEDED."
      },
      "FAILED_PRECONDITION": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code FAILED_PRECONDITION."
      },
      "INTERNAL": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INTERNAL."
      },
      "INVALID_ARGUMENT": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INVALID_ARGUMENT."
      },
      "NOT_FOUND": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code NOT_FOUND."
      },
      "OUT_OF_RANGE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code OUT_OF_RANGE."
      },
      "PERMISSION_DENIED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code PERMISSION_DENIED."
      },
      "RESOURCE_EXHAUSTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code RESOURCE_EXHAUSTED."
      },
      "UNAUTHENTICATED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAUTHENTICATED."
      },
      "UNAVAILABLE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAVAILABLE."
      },
      "UNIMPLEMENTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNIMPLEMENTED."
      },
      "UNKNOWN": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNKNOWN."
      }
    }
  }
}
