{
  "openapi": "3.1.0",
  "info": {
    "title": "structs",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "paths": {
    "/get": {
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Address"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "additionalProperties": false,
        "description": "Address is where mail goes.",
        "properties": {
          "city": {
            "type": "string"
          },
          "street": {
            "description": "Street line.",
            "type": "string"
          }
        },
        "required": [
          "street",
          "city"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CANCELED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS",
                  "UNAUTHENTICATED"
                ],
                "type": "string"
              },
              "details": {},
              "issues": {
                "items": {
                  "$ref": "#/components/schemas/Issue"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ],
        "type": "object"
      },
      "Person": {
        "additionalProperties": false,
        "properties": {
          "NoTag": {
            "type": "string"
          },
          "age": {
            "format": "int32",
            "maximum": 150,
            "minimum": 0,
            "type": "integer"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "home": {
            "$ref": "#/components/schemas/Address"
          },
          "inline": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "format": "int32",
                "type": "integer"
              }
            },
            "required": [
              "x"
            ],
            "type": "object"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "age",
          "email",
          "home",
          "NoTag",
          "inline"
        ],
        "type": "object"
      }
    },
    "responses": {
      "ABORTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ABORTED."
      },
      "ALREADY_EXISTS": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ALREADY_EXISTS."
      },
      "CANCELED": {
