{
  "openapi": "3.1.0",
  "info": {
    "title": "examples",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "paths": {
    "/get": {
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {},
                  "type": "object"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sample"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "additionalProperties": false,
        "properties": {
          "city": {
            "examples": [
              "Paris"
            ],
            "type": "string"
          }
        },
        "required": [
          "city"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CANCELED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS",
                  "UNAUTHENTICATED"
                ],
                "type": "string"
              },
              "details": {},
              "issues": {
                "items": {
                  "$ref": "#/components/schemas/Issue"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ],
        "type": "object"
      },
      "Level": {
        "enum": [
          1,
          10
        ],
        "type": "integer"
      },
      "Sample": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "examples": [
              true
            ],
            "type": "boolean"
          },
          "age": {
            "examples": [
              36
            ],
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "big": {
            "examples": [
              "9007199254740993"
            ],
            "format": "int64",
            "type": "string"
          },
          "blob": {
            "contentEncoding": "base64",
            "examples": [
              "aGVsbG8="
            ],
            "type": "string"
          },
          "counts": {
            "additionalProperties": {
              "format": "int32",
              "type": "integer"
            },
            "examples": [
              {
                "x": 1
              }
            ],
            "type": "object"
          },
          "email": {
            "examples": [
              "ada@example.com"
            ],
            "format": "email",
            "type": "string"
          },
          "home": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Address"
              }
            ],
            "examples": [
              {
                "city": "Rome"
              }
            ]
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Level"
              }
            ],
            "examples": [
              10
            ]
          },
          "name": {
            "examples": [
              "Ada Lovelace"
            ],
            "type": "string"
          },
          "nick": {
            "examples": [
              "ada"
            ],
            "type": "string"
          },
          "ratings": {
            "items": {
              "$ref": "#/components/schemas/Level"
            },
            "type": "array"
          },
          "ratio": {
            "examples": [
              0.75
            ],
            "format": "double",
            "type": "number"
          },
          "raw": {
            "examples": [
              {
                "any": 1
              }
            ]
          },
          "since": {
            "examples": [
              "2026-01-01T00:00:00Z"
            ],
            "format": "date-time",
            "type": "string"
          },
          "slug": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Slug"
              }
            ],
            "examples": [
              "ada-lovelace"
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Status"
              }
            ],
            "examples": [
              "sent"
            ]
          },
          "tags": {
            "examples": [
              [
                "a",
                "b"
              ]
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "timeout": {
            "description": "Duration in nanoseconds.",
            "examples": [
              1500000000
            ],
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "email",
          "age",
          "big",
          "ratio",
          "active",
          "status",
          "level",
          "slug",
          "since",
          "timeout",
          "blob",
          "raw",
          "tags",
          "counts",
          "home",
          "ratings"
        ],
        "type": "object"
      },
      "Slug": {
        "type": "string"
      },
      "Status": {
        "enum": [
          "draft",
          "sent"
        ],
        "type": "string"
      }
    },
    "responses": {
      "ABORTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ABORTED."
      },
      "ALREADY_EXISTS": {
