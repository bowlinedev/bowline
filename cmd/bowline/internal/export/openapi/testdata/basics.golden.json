{
  "openapi": "3.1.0",
  "info": {
    "title": "basics",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api"
    }
  ],
  "paths": {
    "/echo": {
      "get": {
        "operationId": "echo",
        "parameters": [
          {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Input"
                }
              }
            },
            "in": "query",
            "name": "input",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Output"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "$ref": "#/components/responses/INVALID_ARGUMENT"
          },
          "500": {
            "$ref": "#/components/responses/INTERNAL"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CANCELED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS",
                  "UNAUTHENTICATED"
                ],
                "type": "string"
              },
              "details": {},
              "issues": {
                "items": {
                  "$ref": "#/components/schemas/Issue"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Input": {
        "additionalProperties": false,
        "properties": {
          "big": {
            "format": "int64",
            "type": "integer"
          },
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "on": {
            "type": "boolean"
          },
          "ratio": {
            "format": "double",
            "type": "number"
          },
          "small": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "count",
          "small",
          "big",
          "ratio",
          "on"
        ],
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "rule",
          "message"
        ],
        "type": "object"
      },
      "Output": {
        "additionalProperties": false,
        "properties": {
          "echo": {
            "type": "string"
          }
        },
        "required": [
          "echo"
        ],
        "type": "object"
      }
    },
    "responses": {
      "ABORTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code ABORTED."
      },
      "ALREADY_EXISTS": {
        "content": {
          "application/json": {
