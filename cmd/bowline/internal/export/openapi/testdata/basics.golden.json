        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code FAILED_PRECONDITION."
      },
      "INTERNAL": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code INTERNAL."
      },
      "INVALID_ARGUMENT": {
