            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code PERMISSION_DENIED."
      },
      "RESOURCE_EXHAUSTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code RESOURCE_EXHAUSTED."
      },
      "UNAUTHENTICATED": {
        "content": {
