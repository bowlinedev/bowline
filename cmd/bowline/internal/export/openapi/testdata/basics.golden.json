      "UNAVAILABLE": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNAVAILABLE."
      },
      "UNIMPLEMENTED": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error with code UNIMPLEMENTED."
