{
  "get": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "output": {
      "$defs": {
        "Address": {
          "additionalProperties": false,
          "properties": {
            "city": {
              "examples": [
                "Paris"
              ],
              "type": "string"
            }
          },
          "required": [
            "city"
          ],
          "type": "object"
        },
        "Level": {
          "enum": [
            1,
            10
          ],
          "type": "integer"
        },
        "Sample": {
          "additionalProperties": false,
          "properties": {
            "active": {
              "examples": [
                true
              ],
              "type": "boolean"
            },
            "age": {
              "examples": [
                36
              ],
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            "big": {
              "examples": [
                "9007199254740993"
              ],
              "pattern": "^-?[0-9]+$",
              "type": "string"
            },
            "blob": {
              "contentEncoding": "base64",
              "examples": [
                "aGVsbG8="
              ],
              "type": "string"
            },
            "counts": {
              "additionalProperties": {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              },
              "examples": [
                {
                  "x": 1
                }
              ],
              "type": "object"
            },
            "email": {
              "examples": [
                "ada@example.com"
              ],
              "format": "email",
              "type": "string"
            },
            "home": {
              "$ref": "#/$defs/Address",
              "examples": [
                {
                  "city": "Rome"
                }
              ]
            },
            "level": {
              "$ref": "#/$defs/Level",
              "examples": [
                10
              ]
            },
            "name": {
              "examples": [
                "Ada Lovelace"
              ],
              "minLength": 1,
              "type": "string"
            },
            "nick": {
              "examples": [
                "ada"
              ],
              "type": "string"
            },
            "ratings": {
              "items": {
                "$ref": "#/$defs/Level"
              },
              "type": "array"
            },
            "ratio": {
              "examples": [
                0.75
              ],
              "type": "number"
            },
            "raw": {
              "examples": [
                {
                  "any": 1
                }
              ]
            },
            "since": {
              "examples": [
                "2026-01-01T00:00:00Z"
              ],
              "format": "date-time",
              "type": "string"
            },
            "slug": {
              "examples": [
                "ada-lovelace"
              ],
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/Status",
              "examples": [
                "sent"
              ]
            },
            "tags": {
              "examples": [
                [
                  "a",
                  "b"
                ]
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "timeout": {
              "description": "duration in nanoseconds",
              "examples": [
                1500000000
              ],
              "type": "integer"
            }
          },
          "required": [
            "active",
            "age",
            "big",
            "blob",
            "counts",
            "email",
            "home",
            "level",
            "name",
            "ratings",
            "ratio",
            "raw",
            "since",
            "slug",
            "status",
            "tags",
            "timeout"
          ],
          "type": "object"
        },
        "Status": {
          "enum": [
            "draft",
            "sent"
          ],
          "type": "string"
        }
      },
      "$ref": "#/$defs/Sample",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  }
}
