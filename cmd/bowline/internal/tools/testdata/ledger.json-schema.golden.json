[
  {
    "description": "Search finds customers whose name or email contains the query.",
    "destructive": false,
    "inputSchema": {
      "$defs": {
        "SearchCustomersInput": {
          "additionalProperties": false,
          "properties": {
            "query": {
              "minLength": 2,
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        }
      },
      "$ref": "#/$defs/SearchCustomersInput",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "name": "customers_search",
    "outputSchema": {
      "$defs": {
        "Customer": {
          "additionalProperties": false,
          "properties": {
            "createdAt": {
              "format": "date-time",
              "type": "string"
            },
            "email": {
              "format": "email",
              "minLength": 1,
              "type": "string"
            },
            "id": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "updatedAt": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "createdAt",
            "email",
            "id",
            "name",
            "updatedAt"
          ],
          "type": "object"
        },
        "Page_Customer": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/Customer"
              },
              "type": "array"
            },
            "nextCursor": {
              "type": "string"
            }
          },
          "required": [
            "items"
          ],
          "type": "object"
        }
      },
      "$ref": "#/$defs/Page_Customer",
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "procedure": "customers.search",
    "readOnly": true,
    "scopes": [
      "crm"
    ]
  },
