{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "examples/**",
      "*.json",
      "!**/dist",
      "!**/src/bowline.ts",
      "!**/bowline.contract.json",
      "!**/test-results",
      "!.claude"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
